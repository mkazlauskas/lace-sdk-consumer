VITE_BLOCKFROST_URL_PREPROD=https://cardano-preprod.blockfrost.io
VITE_BLOCKFROST_PROJECT_ID_PREPROD=
VITE_PASSKEY_SIGNER_URL=https://passkey-preview.lace.io
# Optional tip poll interval in milliseconds (default 30000)
# VITE_TIP_POLL_MS=30000

# Fee sponsor relay of the Vite dev and preview servers (sponsor-relay.ts).
# The browser calls /sponsor on its own origin; the server forwards to
# SPONSOR_URL with SPONSOR_API_KEY as the bearer token.
SPONSOR_URL=https://sponsor-preprod.lw.iog.io
# The Lace testing key the sponsor operator shared. It is a secret: keep it
# in your own .env or in the server's environment, never commit it, and never
# rename it with a VITE_ prefix, which would inline it into the browser
# bundle. The server refuses to start with a VITE_ sponsor key.
SPONSOR_API_KEY=
